<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/dashboard.css">
    <title>Dashboard - List App</title>
    <style>
        body{
            background-color: <%= cores.bg %> !important;
            color: <%= cores.color %> !important;
        }
        .sidebar {
            background-color: <%= cores.sidebarBg %> !important;
            color: <%= cores.sidebarColor %> !important; 
        }
        #user_infos,
        #user_infos span:first-child,
        #logout_btn,
        #logout_btn i,
        .sidebar .item-description {
            color: <%= cores.sidebarColor %> !important;
        }

        #user_infos span:last-child {
            color: <%= temaAtual == 'escuro' ? '#aaaaaa' : '#6b6b6b' %> !important;
        }

        #logout {
            border-top: 1px solid <%= temaAtual == 'escuro' ? '#333333' : '#e3e9f7' %> !important;
        }

        .side-item:hover:not(.active),
        #logout_btn:hover {
            background-color: <%= temaAtual == 'escuro' ? '#333333' : '#e3e9f7' %> !important;
        }
        .modal-conteudo {
            background-color: <%= cores.sidebarBg %> !important;
            color: <%= cores.color %> !important;
        }

        .modal-conteudo input {
            background-color: <%= cores.sidebarBg %> !important;
            color: <%= cores.color %> !important;
        }

        .modal-conteudo input::placeholder {
            color: <%= temaAtual == 'escuro' ? '#888888' : '#666666' %> !important;
        }

        .btn-secundario {
            color: <%= cores.color %> !important;
        }

        .btn-secundario:hover {
            background-color: <%= temaAtual == 'escuro' ? '#333333' : '#90909034' %> !important;
        }
        .note_item label::before {
            border-color: <%= temaAtual == 'escuro' ? '#e8e8e8' : '#0e0e0e' %> !important;
        }

        .note_item input[type="radio"]:checked + label::before {
            border-color: <%= temaAtual == 'escuro' ? '#e8e8e8' : '#0e0e0e' %> !important;
        }

        .note_item label {
            border-top-color: <%= temaAtual == 'escuro' ? '#444444' : 'gray' %> !important;
        }
    </style>
</head>
<body>
    <nav class="sidebar">
        <div id="sidebar_content">
            <div id="user">
                <img src="/img/avatar.png" id="user_avatar" alt="Avatar">
                <p id="user_infos">
                    <span class="item-description">Joãozinho</span>
                    <span>Plano free</span>
                </p>
            </div>

            <ul id="side_items">
                <li class="side-item active">
                    <a href="/dashboard">
                        <i class="fa-solid fa-inbox"></i>
                        <span class="item-description">Caixa de Entrada</span>
                    </a>
                </li>
            </ul>

            <ul id="side_items">
                <li class="side-item active">
                    <a href="/config">
                        <i class="fa-solid fa-sliders"></i>
                        <span class="item-description">Configurações</span>
                    </a>
                </li>
            </ul>
        </div>

        <div id="logout">
            <a id="logout_btn_link" href="/login">
                <button id="logout_btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="item-description">Sair</span>
                </button>
            </a>
        </div>
    </nav>

    <main>
        <div id="main_content">
            <h1 id="main_title">Entrada</h1>

            <button id="btn_abrir_modal" class="btn-flutuante">+</button>

            <div id="modal_tarefa" class="modal-container">
                <div class="modal-conteudo">
                    
                    <input type="text" id="input_tarefa_nome" placeholder="Nome da tarefa">
                    <div class="modal-btn">
                        <button id="btn_cancelar" class="btn-secundario">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <button id="btn_salvar" class="btn-primario">
                            <i class="fa-solid fa-arrow-up"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div id="lista_tarefas" class="container-lista"></div>

            <div id="retorno_container" class="position-fixed bottom-0 end-0 p-3"></div>

            <script src="/js/dashboard.js"></script>
        </div>  
    </main>
</body>
</html>
