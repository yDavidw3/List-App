<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/dashboard.css">
    <title>Dashboard - List App</title>
    <style>
        body{
            background-color: <%= cores.bg %> !important;
            color: <%= cores.color %> !important;
        }
        .sidebar {
            background-color: <%= cores.sidebarBg %> !important;
            color: <%= cores.sidebarColor %> !important; 
        }
        #user_infos,
        #user_infos span:first-child,
        #logout_btn,
        #logout_btn i,
        .sidebar .item-description {
            color: <%= cores.sidebarColor %> !important;
        }

        #user_infos span:last-child {
            color: <%= temaAtual == 'escuro' ? '#aaaaaa' : '#6b6b6b' %> !important;
        }

        #logout {
            border-top: 1px solid <%= temaAtual == 'escuro' ? '#333333' : '#e3e9f7' %> !important;
        }

        .side-item:hover:not(.active),
        #logout_btn:hover {
            background-color: <%= temaAtual == 'escuro' ? '#333333' : '#e3e9f7' %> !important;
        }

        .modal-content {
            background-color: <%= cores.sidebarBg %> !important;
            color: <%= cores.color %> !important;
        }

        .form-control,
        .form-select {
            background-color: <%= temaAtual == 'escuro' ? '#2a2a2a' : '#ffffff' %> !important;
            color: <%= cores.color %> !important;
            border-color: <%= temaAtual == 'escuro' ? '#444444' : '#ced4da' %> !important;
        }

        .list-group-item {
            background-color: <%= cores.sidebarBg %> !important;
            color: <%= cores.color %> !important;
            border-color: <%= temaAtual == 'escuro' ? '#333333' : '#e3e9f7' %> !important;
        }
    </style>
</head>
<body>
    <nav class="sidebar">
        <div id="sidebar_content">
            <div id="user">
                <img src="/img/avatar.png" id="user_avatar" alt="Avatar">
                <p id="user_infos">
                    <span class="item-description">Joãozinho</span>
                    <span>Plano free</span>
                </p>
            </div>

            <ul id="side_items">
                <li class="side-item active">
                    <a href="/dashboard">
                        <i class="fa-solid fa-inbox"></i>
                        <span class="item-description">Caixa de Entrada</span>
                    </a>
                </li>
            </ul>

            <ul id="side_items">
                <li class="side-item active">
                    <a href="/config">
                        <i class="fa-solid fa-sliders"></i>
                        <span class="item-description">Configurações</span>
                    </a>
                </li>
            </ul>
        </div>

        <div id="logout">
            <a id="logout_btn_link" href="/login">
                <button id="logout_btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="item-description">Sair</span>
                </button>
            </a>
        </div>
    </nav>

    <main>
        <div id="main_content">
            <h1 id="main_title">Entrada</h1>

            <button id="btn_abrir_modal" class="btn-flutuante" data-bs-toggle="modal" data-bs-target="#modal_tarefa">+</button>

            <div class="modal fade" id="modal_tarefa" tabindex="-1" aria-labelledby="modal_tarefa_label" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modal_tarefa_label">Nova tarefa</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="input_tarefa_nome" class="form-label">Nome da tarefa</label>
                                <input type="text" class="form-control" id="input_tarefa_nome" placeholder="Ex: Estudar para a prova">
                            </div>
                            <div class="mb-3">
                                <label for="select_tarefa_etiqueta" class="form-label">Etiqueta</label>
                                <select class="form-select" id="select_tarefa_etiqueta">
                                    <option value="Pessoal">Pessoal</option>
                                    <option value="Trabalho">Trabalho</option>
                                    <option value="Urgente">Urgente</option>
                                    <option value="Estudo">Estudo</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="input_tarefa_prazo" class="form-label">Prazo</label>
                                <input type="date" class="form-control" id="input_tarefa_prazo">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" id="btn_salvar" class="btn btn-primary">Salvar</button>
                        </div>
                    </div>
                </div>
            </div>

            <ul id="lista_tarefas" class="list-group w-100"></ul>

            <div id="retorno_container" class="position-fixed bottom-0 end-0 p-3"></div>

            <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
            <script src="/js/dashboard.js"></script>
        </div>  
    </main>
</body>
</html>