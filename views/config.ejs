<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/dashboard.css">
    <title>Configurações - List App</title>
</head>
<body style="background-color: <%= tema.bg %>; color: <%= tema.text %>;">

    <nav id="sidebar">
        <div id="sidebar_content">
            <div id="user">
                <img src="/img/avatar.png" id="user_avatar" alt="Avatar">

                <p id="user_infos">
                    <span class="item-description">Usuário</span>
                    <span>Plano free</span>
                </p>
            </div>

            <ul id="side_items">
                <li class="side-item active">
                    <a href="/dashboard">
                        <i class="fa-solid fa-inbox"></i>
                        <span class="item-description">Caixa de Entrada</span>
                    </a>
                </li>
            </ul>

            <ul id="side_items">
                <li class="side-item active">
                    <a href="/sobre">
                        <i class="fa-solid fa-circle-info"></i>
                        <span class="item-description">Sobre nós</span>
                    </a>
                </li>
            </ul>

            <ul id="side_items">
                <li class="side-item active">
                    <a href="/config">
                        <i class="fa-solid fa-sliders"></i>
                        <span class="item-description">Configurações</span>
                    </a>
                </li>
            </ul>
        </div>

        <div id="logout">
            <a id="logout_btn_link" href="/login">
                <button id="logout_btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="item-description">Sair</span>
                </button>
            </a>
        </div>
    </nav>

    <main>
        <div id="main_content">
            <h1 id="main_title">Configurações</h1>

            <span class="config-frase">
                Personalize o List App com cores que combinam com seu estilo, humor e personalidade.
            </span>

            <div class="tema">
                <span>Habilitar o tema escuro</span>

                <form action="/temas" method="POST">
                    <input type="hidden" name="tema" value="claro">

                    <label class="switch">
                        <input
                            type="checkbox"
                            name="tema"
                            value="escuro"
                            <%= nomeTema === 'Escuro' ? 'checked' : '' %>
                            onchange="this.form.submit()"
                        >
                        <span class="slider"></span>
                    </label>
                </form>
            </div>

            <p>Tema atual: <%= nomeTema %></p>
        </div>
    </main>

</body>
</html>